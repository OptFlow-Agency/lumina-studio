---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lumina Studio — Interior Design & Curation",
  description = "Bespoke interior design and architectural curation services.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-[#FAF7F2] text-stone-900 font-serif antialiased selection:bg-[#C49A78] selection:text-white overflow-x-hidden">
    <slot />

    <!-- Lenis & Scroll Animations Script -->
    <script>
      import Lenis from "lenis";

      // 1. Initialize Lenis Smooth Scroll
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: "vertical",
        gestureOrientation: "vertical",
        smoothWheel: true,
        wheelMultiplier: 1,
        touchMultiplier: 2,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);

      // 2. Intersection Observer for Scroll Animations
      const initObserver = () => {
        const observerOptions = {
          root: null,
          rootMargin: "0px 0px -50px 0px",
          threshold: 0.1,
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              obs.unobserve(entry.target); // Trigger once
            }
          });
        }, observerOptions);

        const revealElements = document.querySelectorAll(".reveal");
        revealElements.forEach((el) => observer.observe(el));
      };

      // Run on page load & Astro view transitions (if used)
      document.addEventListener("DOMContentLoaded", initObserver);
      document.addEventListener("astro:page-load", initObserver);
    </script>
  </body>
</html>
