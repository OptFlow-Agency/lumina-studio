---
// src/components/ServicesSection.astro

const services = [
  {
    number: "01",
    title: "Full-Service Interior Design",
    description:
      "Concept development, spatial planning, 3D renderings, material selection, procurement, and project management through final setup.",
    bestFor: "Major renovations, new builds, or full-home redesigns",
    tags: ["3D Renderings", "Procurement", "Project Management"],
  },
  {
    number: "02",
    title: "Interior Styling & Furnishing",
    description:
      "Color palette creation, custom furniture selection, lighting, art procurement, textiles, and final styling.",
    bestFor: "Refreshing furnished or newly acquired spaces",
    tags: ["Color Palettes", "Custom Furniture", "Art Curation"],
  },
  {
    number: "03",
    title: "Virtual Design (E-Design)",
    description:
      "Virtual room layout, interactive mood boards, curated shopping lists, and a step-by-step setup guide.",
    bestFor: "Clients anywhere seeking expert direction",
    tags: ["Mood Boards", "Shopping Lists", "Remote Guidance"],
  },
];

// Helper array for dynamic delay classes
const delays = ["delay-100", "delay-200", "delay-300"];
---

<section
  id="service"
  class="w-full bg-[#FAF7F2] text-stone-900 py-16 sm:py-24 px-4 sm:px-12 md:px-20 lg:px-28 font-serif select-none relative overflow-hidden"
>
  <!-- Subtle Soft Warm Glow in Background -->
  <div class="absolute -top-24 right-10 w-[500px] h-[500px] bg-[#C49A78]/10 blur-[130px] rounded-full pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-10 w-[500px] h-[500px] bg-[#D4AF37]/10 blur-[130px] rounded-full pointer-events-none"></div>

  <div class="max-w-6xl mx-auto space-y-12 sm:space-y-16 relative z-10">
    <!-- Header with Architectural Accent -->
    <div class="reveal flex flex-col md:flex-row md:items-end justify-between border-b border-stone-300/70 pb-6 gap-4">
      <div>
        <span class="text-xs font-sans tracking-[0.25em] uppercase text-[#C49A78] font-medium block mb-2">
          What We Offer
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-wide text-stone-900">
          Our <span class="text-[#C49A78] font-normal">Services</span>
        </h2>
      </div>
      <p class="text-sm font-sans tracking-widest uppercase text-stone-500 max-w-xs">
        Bespoke solutions crafted for your lifestyle
      </p>
    </div>

    <!-- Image-Free Interactive Cards (Each animates individually) -->
    <div class="grid grid-cols-1 gap-8">
      {services.map((service, index) => (
        <div
          class={`reveal ${delays[index % delays.length]} group relative bg-[#F4EFE6]/70 hover:bg-[#EFE7DC] p-8 sm:p-12 rounded-sm border border-stone-300/60 hover:border-[#C49A78]/60 transition-all duration-500 ease-out shadow-sm hover:shadow-md`}
        >
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-8">
            <!-- Number Accent -->
            <div class="flex items-center justify-between lg:block">
              <span class="text-4xl sm:text-5xl lg:text-6xl font-light text-[#C49A78]/70 group-hover:text-[#C49A78] transition-colors duration-300">
                {service.number}
              </span>
              <!-- Mobile Indicator Arrow -->
              <span class="lg:hidden text-[#C49A78]">&rarr;</span>
            </div>

            <!-- Content Area -->
            <div class="flex-1 space-y-4">
              <h3 class="text-2xl sm:text-3xl lg:text-4xl font-light tracking-wide text-stone-900 group-hover:translate-x-1 transition-transform duration-300">
                {service.title}
              </h3>

              <p class="text-base sm:text-lg lg:text-xl font-light text-stone-700 leading-relaxed max-w-3xl tracking-wide">
                {service.description}
              </p>

              <!-- Tags / Scope Pills -->
              <div class="flex flex-wrap gap-2 pt-2">
                {service.tags.map((tag) => (
                  <span class="text-[11px] font-sans tracking-widest uppercase bg-stone-200/60 text-stone-700 px-3 py-1 rounded-full border border-stone-300/40">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Best For Section -->
              <div class="pt-4 border-t border-stone-300/40 flex items-center gap-2">
                <span class="text-[#C49A78] font-normal text-sm sm:text-base">
                  Best For:
                </span>
                <span class="text-sm sm:text-base font-light text-stone-600 italic">
                  {service.bestFor}
                </span>
              </div>
            </div>

            <!-- Desktop Arrow Button Icon -->
            <div class="hidden lg:flex items-center justify-center w-12 h-12 rounded-full border border-stone-300/80 group-hover:border-[#C49A78] group-hover:bg-[#C49A78] text-stone-600 group-hover:text-white transition-all duration-300 self-center">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 transform group-hover:translate-x-0.5 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
