---
// Import images from assets directory
import PhilosophyMain from "../assets/about/design-1.jpeg";
import PhilosophyTopRight from "../assets/about/design-2.jpeg";
import PhilosophyBottomRight from "../assets/about/design-3.jpeg";
import { Image } from "astro:assets";
---

<section
  id="about"
  class="w-full bg-[#FAF7F2] text-stone-900 py-12 sm:py-20 px-4 sm:px-12 md:px-20 lg:px-28 font-serif select-none"
>
  <div class="max-w-6xl mx-auto space-y-8 sm:space-y-12">
    <!-- Title & Intro Paragraph -->
    <div class="max-w-3xl space-y-4 sm:space-y-6">
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-light tracking-wide text-stone-900">
        Our Design <span class="text-[#C49A78] font-normal">Philosophy</span>
      </h2>

      <p class="text-sm sm:text-xl md:text-2xl font-light text-stone-800 leading-relaxed tracking-wide">
        At <span class="font-semibold text-[#797D62]">Lumina Studio</span>, we
        believe your environment deeply shapes how you feel, focus, and thrive.
        A truly exceptional space isn’t just beautiful to look at, it’s
        intuitively functional, thoughtfully curated, and uniquely tailored to
        your life.
      </p>
    </div>

    <!-- Asymmetrical Gallery Grid (Keeps side-by-side structure on mobile) -->
    <div class="grid grid-cols-12 gap-2 sm:gap-6 lg:gap-10 items-start pt-2 sm:pt-4">
      <!-- Left Main Image (7 Columns) -->
      <div class="col-span-7">
        <Image
          src={PhilosophyMain}
          alt="Lumina Studio interior design living room"
          class="w-full h-48 sm:h-96 md:h-[500px] lg:h-[600px] object-cover rounded-sm shadow-sm"
        />
      </div>

      <!-- Right Column Stacked Images (5 Columns) -->
      <div class="col-span-5 flex flex-col space-y-2 sm:space-y-6 lg:space-y-8">
        <!-- Top Right Small Accent Image -->
        <div class="w-3/4 ml-auto">
          <Image
            src={PhilosophyTopRight}
            alt="Interior corner detail with bookcase"
            class="w-full h-20 sm:h-44 md:h-56 lg:h-64 object-cover rounded-sm shadow-sm"
          />
        </div>

        <!-- Bottom Right Medium Image -->
        <div class="w-full">
          <Image
            src={PhilosophyBottomRight}
            alt="Warm gallery wall room setup"
            class="w-full h-28 sm:h-56 md:h-80 lg:h-[380px] object-cover rounded-sm shadow-sm"
          />
        </div>
      </div>
    </div>

    <!-- Closing Description Paragraph -->
    <div class="pt-4 sm:pt-8 max-w-4xl">
      <p class="text-sm sm:text-xl md:text-2xl font-light text-stone-800 leading-relaxed tracking-wide">
        Whether transforming a single room or guiding a complete architectural
        renovation, we combine clean lines, rich textures, and intelligent
        layouts to craft interiors that feel balanced, refined, and personal.
      </p>
    </div>
  </div>
</section>
