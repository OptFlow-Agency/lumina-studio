---
import HeroBg from "../assets/interior-bg.jpg";
import Header from "./header.astro";
---

<section
  class="relative min-h-screen w-full bg-cover bg-center flex flex-col justify-between overflow-hidden font-serif select-none"
  style={`background-image: url('${HeroBg.src}');`}
>
  <!-- Dark Dimming Overlay -->
  <div class="absolute inset-0 bg-black/50 z-0"></div>

  <!-- Navigation Header (Animates First: 300ms Delay) -->
  <Header />

  <!-- Horizontal Glow Accent Line -->
  <div class="hero-fade-in delay-200 relative z-10 w-full px-6 md:px-16">
    <div class="h-[1px] w-full bg-gradient-to-r from-stone-400/30 via-[#D4AF37]/50 to-stone-400/30"></div>
  </div>

  <!-- Hero Content (Staggered Animations) -->
  <main class="relative z-10 flex-1 flex flex-col justify-center px-6 md:px-18 lg:px-28 py-12 text-stone-100 max-w-7xl mx-auto w-full">
    <div class="space-y-2 text-center md:text-left md:space-y-4 max-w-5xl">
      <!-- Headline Line 1 -->
      <h1 class="hero-fade-in delay-300 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-light tracking-normal leading-tight">
        Elevating Everyday Spaces
      </h1>

      <!-- Headline Line 2 -->
      <h2 class="hero-fade-in delay-400 text-4xl sm:text-5xl md:text-6xl lg:text-6xl font-light tracking-normal leading-tight md:pl-28 lg:pl-48 drop-shadow-lg">
        Into Extraordinary Homes.
      </h2>

      <!-- Subtitle Paragraph -->
      <p class="hero-fade-in delay-500 mt-8 md:mt-12 text-lg sm:text-xl md:text-2xl font-light text-stone-200/90 leading-relaxed max-w-2xl md:ml-[30%] lg:ml-[38%] drop-shadow">
        Tailored interior design services blending functional luxury, personal
        story, and timeless aesthetics.
      </p>
    </div>
  </main>

  <!-- Decorative Spacer -->
  <div class="relative z-10 h-16 w-full"></div>
</section>

<!-- Add Keyframe Animations -->
<style>
  .hero-fade-in {
    opacity: 0;
    transform: translateY(24px);
    animation: slideUpFade 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-100 {
    animation-delay: 200ms;
  }
  .delay-200 {
    animation-delay: 400ms;
  }
  .delay-300 {
    animation-delay: 600ms;
  }
  .delay-400 {
    animation-delay: 800ms;
  }
  .delay-500 {
    animation-delay: 1000ms;
  }

  @keyframes slideUpFade {
    0% {
      opacity: 0;
      transform: translateY(24px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const menuBtn = document.getElementById("menu-toggle");
  menuBtn?.addEventListener("click", () => {
    console.log("Menu toggled");
  });
</script>
