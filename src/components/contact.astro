---
// src/components/Contact.astro
---

<section
  id="contact"
  class="w-full bg-[#FAF7F2] text-stone-900 py-20 sm:py-28 px-6 sm:px-12 md:px-20 lg:px-28 font-serif select-none relative border-t border-stone-200/60"
>
  <div class="max-w-6xl mx-auto space-y-16">
    <!-- Section Header -->
    <div class="reveal text-center max-w-2xl mx-auto space-y-3">
      <span class="text-xs font-sans tracking-[0.25em] uppercase text-[#C49A78] font-medium block">
        Start a Conversation
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-wide text-stone-900">
        Let’s Work <span class="text-[#C49A78] font-normal">Together</span>
      </h2>
      <p class="text-base sm:text-lg font-light text-stone-600 font-serif pt-2">
        Have an upcoming project or spatial inquiry? We’d love to hear about
        your vision.
      </p>
      <div class="w-12 h-[1px] bg-[#C49A78]/60 mx-auto mt-4"></div>
    </div>

    <!-- Main Grid: Form + Info Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Contact Form -->
      <form class="reveal delay-100 lg:col-span-7 bg-[#F4EFE6]/60 p-8 sm:p-12 rounded-sm border border-stone-300/60 shadow-sm space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Full Name -->
          <div class="space-y-2">
            <label
              for="name"
              class="block font-sans text-xs tracking-[0.15em] uppercase text-stone-600 font-medium"
            >
              Full Name *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="e.g. Elena Rostova"
              class="w-full bg-[#FAF7F2] border border-stone-300 px-4 py-3 text-stone-900 text-sm font-sans placeholder:text-stone-400 focus:outline-none focus:border-[#C49A78] focus:ring-1 focus:ring-[#C49A78] transition-colors rounded-sm"
            />
          </div>

          <!-- Email Address -->
          <div class="space-y-2">
            <label
              for="email"
              class="block font-sans text-xs tracking-[0.15em] uppercase text-stone-600 font-medium"
            >
              Email Address *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="elena@example.com"
              class="w-full bg-[#FAF7F2] border border-stone-300 px-4 py-3 text-stone-900 text-sm font-sans placeholder:text-stone-400 focus:outline-none focus:border-[#C49A78] focus:ring-1 focus:ring-[#C49A78] transition-colors rounded-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Phone Number -->
          <div class="space-y-2">
            <label
              for="phone"
              class="block font-sans text-xs tracking-[0.15em] uppercase text-stone-600 font-medium"
            >
              Phone Number
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+34 600 000 000"
              class="w-full bg-[#FAF7F2] border border-stone-300 px-4 py-3 text-stone-900 text-sm font-sans placeholder:text-stone-400 focus:outline-none focus:border-[#C49A78] focus:ring-1 focus:ring-[#C49A78] transition-colors rounded-sm"
            />
          </div>

          <!-- Project Type -->
          <div class="space-y-2">
            <label
              for="project-type"
              class="block font-sans text-xs tracking-[0.15em] uppercase text-stone-600 font-medium"
            >
              Project Scope
            </label>
            <select
              id="project-type"
              name="project-type"
              class="w-full bg-[#FAF7F2] border border-stone-300 px-4 py-3 text-stone-900 text-sm font-sans focus:outline-none focus:border-[#C49A78] focus:ring-1 focus:ring-[#C49A78] transition-colors rounded-sm cursor-pointer"
            >
              <option value="residential">Full Residential Design</option>
              <option value="commercial">Commercial / Studio Space</option>
              <option value="renovation">Renovation & Spatial Planning</option>
              <option value="consultation">Design Consultation Only</option>
            </select>
          </div>
        </div>

        <!-- Message -->
        <div class="space-y-2">
          <label
            for="message"
            class="block font-sans text-xs tracking-[0.15em] uppercase text-stone-600 font-medium"
          >
            Project Details & Vision
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Tell us about the property, timeline, location, or overall vision..."
            class="w-full bg-[#FAF7F2] border border-stone-300 p-4 text-stone-900 text-sm font-sans placeholder:text-stone-400 focus:outline-none focus:border-[#C49A78] focus:ring-1 focus:ring-[#C49A78] transition-colors rounded-sm resize-none"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full sm:w-auto px-8 py-4 bg-stone-900 text-[#FAF7F2] font-sans text-xs tracking-[0.2em] uppercase font-medium hover:bg-[#C49A78] transition-colors duration-300 rounded-sm cursor-pointer"
        >
          Send Inquiry
        </button>
      </form>

      <!-- Sidebar: Contact Info & Address -->
      <div class="reveal delay-200 lg:col-span-5 space-y-10 font-sans">
        <!-- Address & Office -->
        <div class="space-y-3">
          <span class="text-xs tracking-[0.2em] uppercase text-[#C49A78] font-medium block">
            Studio Location
          </span>
          <h3 class="font-serif text-2xl font-light text-stone-900">
            Barcelona Studio
          </h3>
          <p class="text-stone-600 text-sm font-serif leading-relaxed">
            Carrer Ausias Marc 13, 08010
            <br />
            Barcelona, Spain
          </p>
        </div>

        <div class="w-full h-[1px] bg-stone-300/60"></div>

        <!-- Direct Contact Details -->
        <div class="space-y-4">
          <span class="text-xs tracking-[0.2em] uppercase text-[#C49A78] font-medium block">
            Direct Contact
          </span>

          <div class="space-y-2 text-sm text-stone-800">
            <div class="flex items-center gap-3">
              <span class="text-stone-400 font-medium w-20 uppercase text-xs tracking-wider">
                Email:
              </span>
              <a
                href="mailto:hello@luminastudio.com"
                class="hover:text-[#C49A78] transition-colors font-serif text-base"
              >
                hello@luminastudio.com
              </a>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-stone-400 font-medium w-20 uppercase text-xs tracking-wider">
                Phone:
              </span>
              <a
                href="tel:+34654496780"
                class="hover:text-[#C49A78] transition-colors font-serif text-base"
              >
                +34 654 496 780
              </a>
            </div>
          </div>
        </div>

        <div class="w-full h-[1px] bg-stone-300/60"></div>

        <!-- Business Hours -->
        <div class="space-y-3">
          <span class="text-xs tracking-[0.2em] uppercase text-[#C49A78] font-medium block">
            Hours
          </span>
          <div class="text-sm text-stone-600 font-serif leading-relaxed">
            <p>Monday – Friday: 09:00 – 18:00 CET</p>
            <p>Saturday – Sunday: By Appointment Only</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
